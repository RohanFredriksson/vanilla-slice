{
  "name": "@vanilla-slice/slicing-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@vanilla-slice/core": "*",
    "@vanilla-slice/renderer-three": "*",
    "@vanilla-slice/runtime": "*",
    "three": "^0.169.0"
  },
  "nx": {
    "tags": ["layer:app", "type:app"],
    "targets": {
      "build": {},
      "lint": {},
      "test": {},
      "serve": {
        "executor": "nx:run-commands",
        "options": { "command": "vite", "cwd": "apps/slicing-game" }
      },
      "bundle": {
        "executor": "nx:run-commands",
        "options": { "command": "vite build", "cwd": "apps/slicing-game" },
        "outputs": ["{projectRoot}/dist-web"],
        "cache": true
      },
      "preview": {
        "executor": "nx:run-commands",
        "options": { "command": "vite preview", "cwd": "apps/slicing-game" }
      }
    }
  }
}
