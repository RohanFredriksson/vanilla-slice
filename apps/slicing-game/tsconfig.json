{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "dist"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/renderer-three" },
    { "path": "../../packages/runtime" }
  ]
}
