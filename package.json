{
  "name": "vanilla-slice",
  "version": "0.0.0",
  "private": true,
  "description": "Vanilla Slice — framework-agnostic, renderer-agnostic TypeScript engine for physics, mesh slicing, geometry, and spatial queries.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
