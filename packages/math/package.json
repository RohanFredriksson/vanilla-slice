{
  "name": "@vanilla-slice/math",
  "version": "0.1.1",
  "description": "Zero-dependency 3D math primitives (vectors, matrices, quaternions) for the Vanilla Slice engine.",
  "keywords": [
    "vanilla-slice",
    "3d",
    "math",
    "vector",
    "matrix",
    "quaternion",
    "typescript"
  ],
  "license": "MIT",
  "author": "Rohan Fredriksson <rohan.fredriksson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RohanFredriksson/vanilla-slice.git",
    "directory": "packages/math"
  },
  "homepage": "https://github.com/RohanFredriksson/vanilla-slice/tree/master/packages/math#readme",
  "bugs": "https://github.com/RohanFredriksson/vanilla-slice/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
