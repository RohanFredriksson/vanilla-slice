{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/vitest.config.ts"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b {projectRoot}/tsconfig.json"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint {projectRoot} --max-warnings 0"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests {projectRoot}"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts"
      ],
      "cache": true
    }
  },
  "release": {
    "projects": [
      "@vanilla-slice/math",
      "@vanilla-slice/materials",
      "@vanilla-slice/geometry",
      "@vanilla-slice/physics",
      "@vanilla-slice/spatial",
      "@vanilla-slice/slicing",
      "@vanilla-slice/fracture",
      "@vanilla-slice/interactions",
      "@vanilla-slice/core",
      "@vanilla-slice/renderer-three",
      "@vanilla-slice/runtime"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preVersionCommand": "npx nx run-many -t build"
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "commitMessage": "chore(release): publish {version} [skip ci]"
    }
  },
  "analytics": false
}