{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@vanilla-slice/math": ["packages/math/src/index.ts"],
      "@vanilla-slice/geometry": ["packages/geometry/src/index.ts"],
      "@vanilla-slice/physics": ["packages/physics/src/index.ts"],
      "@vanilla-slice/spatial": ["packages/spatial/src/index.ts"],
      "@vanilla-slice/slicing": ["packages/slicing/src/index.ts"],
      "@vanilla-slice/core": ["packages/core/src/index.ts"],
      "@vanilla-slice/renderer-three": ["packages/renderer-three/src/index.ts"],
      "@vanilla-slice/runtime": ["packages/runtime/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
